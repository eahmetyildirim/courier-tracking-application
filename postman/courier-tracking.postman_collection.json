{
  "info": {
    "name": "Courier Tracking - Case Scenarios",
    "description": "Migros case requirement scenarios for Postman Collection Runner. Each folder resets runtime state first, gets a fresh token, then verifies one requirement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "courierId",
      "value": "1"
    },
    {
      "key": "token",
      "value": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJjb3VyaWVySWQiOjF9.signature"
    },
    {
      "key": "authorizationHeader",
      "value": "Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJjb3VyaWVySWQiOjF9.signature"
    },
    {
      "key": "locationTime1",
      "value": "2026-03-17T10:00:00Z"
    },
    {
      "key": "locationTime2",
      "value": "2026-03-17T10:00:10Z"
    },
    {
      "key": "locationTime3",
      "value": "2026-03-17T10:00:20Z"
    },
    {
      "key": "totalDistance",
      "value": "0"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const defaults = {",
          "  baseUrl: 'http://localhost:8080',",
          "  courierId: '1',",
          "  token: 'eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJjb3VyaWVySWQiOjF9.signature',",
          "  authorizationHeader: 'Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJjb3VyaWVySWQiOjF9.signature',",
          "  locationTime1: '2026-03-17T10:00:00Z',",
          "  locationTime2: '2026-03-17T10:00:10Z',",
          "  locationTime3: '2026-03-17T10:00:20Z',",
          "  totalDistance: '0'",
          "};",
          "Object.entries(defaults).forEach(([key, value]) => {",
          "  if (!pm.collectionVariables.get(key)) {",
          "    pm.collectionVariables.set(key, value);",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Scenario 1 - Store Entry Is Recorded",
      "description": "Kurye Ataşehir MMM Migros 100m yaricapina girince store entry kaydi olusur.",
      "item": [
        {
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/testing/reset-state",
              "path": [
                "api",
                "testing",
                "reset-state"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('reset message exists', function () { pm.expect(pm.response.json().message).to.eql('In-memory runtime state cleared.'); });"
                ]
              }
            }
          ],
          "name": "1. State Reset"
        },
        {
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/testing/example-token?courierId=1",
              "path": [
                "api",
                "testing",
                "example-token"
              ],
              "query": [
                {
                  "key": "courierId",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('courierId', '1');",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('authorizationHeader', body.authorizationHeader);",
                  "pm.collectionVariables.set('locationTime1', '2026-03-17T10:00:00Z');"
                ]
              }
            }
          ],
          "name": "2. Token Al"
        },
        {
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{authorizationHeader}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courier-locations",
              "path": [
                "api",
                "courier-locations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"time\": \"{{locationTime1}}\",\n  \"lat\": 40.9923307,\n  \"lng\": 29.1244229\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "name": "3. Atasehir Yakinina Lokasyon Gonder"
        },
        {
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/testing/store-entry-history?courierId=1",
              "path": [
                "api",
                "testing",
                "store-entry-history"
              ],
              "query": [
                {
                  "key": "courierId",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('one entry exists', function () { pm.expect(body.entryCount).to.eql(1); });",
                  "pm.test('store is Atasehir MMM Migros', function () { pm.expect(body.entries[0].storeName).to.eql('Ataşehir MMM Migros'); });"
                ]
              }
            }
          ],
          "name": "4. Store Entry History Dogrula"
        }
      ]
    },
